{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Ретро СССР — интернет-магазин винтажа",
    "description": "Демо-магазин винтажных вещей из СССР: WooCommerce, 12 разделов, 12 товаров, доставка и демо-оплата.",
    "author": "Sergey",
    "categories": ["woocommerce", "demo", "portfolio"]
  },
  "landingPage": "/shop/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "woocommerce/woocommerce.php"
    },
    {
      "step": "writeFile",
      "path": "/tmp/setup-store.php",
      "data": {
        "resource": "bundled",
        "path": "setup-store.php"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/tmp/setup-store.php'; echo 'STORE READY';"
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    }
  ]
}
